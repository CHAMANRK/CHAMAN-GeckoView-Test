{
  "manifest_version": 2,
  "name": "CHAMAN Cookie Export",
  "version": "2.0.0",
  "description": "Exports cookies of Instagram and YouTube as Netscape cookies.txt, only when the native app asks for it. No page script, no network.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chaman-cookie-bridge-test@chaman.app"
    }
  },
  "permissions": [
    "cookies",
    "geckoViewAddons",
    "nativeMessaging",
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
